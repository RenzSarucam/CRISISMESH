APP_NAME=CrisisMesh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Base URL of this API. The frontend consumes it as {APP_URL}/api/v1 (see NEXT_PUBLIC_API_URL on the frontend).
APP_URL=http://localhost:8000
# Optional: reported by GET /system/status. Falls back to composer.json's version if unset.
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production-intent default is MySQL (docker-compose sets these). For local dev WITHOUT Docker,
# set DB_CONNECTION=sqlite and point DB_DATABASE at an absolute path to database/database.sqlite
# (see backend/database/database.sqlite) -- migrations run identically on both.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crisismesh
DB_USERNAME=root
DB_PASSWORD=
# DB_DATABASE=/absolute/path/to/backend/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum: comma-separated list of domains allowed to receive stateful (cookie) requests.
# Not required for the token-based Bearer auth flow used by the frontend, but harmless to set
# if a cookie-based admin panel is added later.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
