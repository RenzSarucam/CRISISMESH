# ---- Shared / Docker Compose ----
COMPOSE_PROJECT_NAME=crisismesh

# ---- MySQL ----
MYSQL_DATABASE=crisismesh
MYSQL_USER=crisismesh
MYSQL_PASSWORD=crisismesh_secret
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_PORT=3306

# ---- Backend (Laravel) ----
APP_NAME=CrisisMesh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crisismesh
DB_USERNAME=crisismesh
DB_PASSWORD=crisismesh_secret

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
